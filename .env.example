DATABASE_URL=sqlite:///./backend/infomir.sqlite3
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
PROJECT_NAME=Infomir Learning Platform API
DEBUG=true
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ADMIN_HOSTS=admin.localhost,admin.127.0.0.1
ADMIN_SESSION_EXPIRE_MINUTES=30
TEACHER_COMMISSION_PERCENT=20
PAYMENT_PROVIDER=manual
MANUAL_PAYMENT_INSTRUCTIONS=Contact billing@example.com and include the payment request number.
ENABLE_DEV_PAYMENT_CONFIRMATION=false
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=1048576
